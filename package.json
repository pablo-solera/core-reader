    },
    "./http/v1": {
      "types": "./dist/http/v1.d.ts",
      "import": "./dist/http/v1.js"
    },
    "./testing/conformance": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
