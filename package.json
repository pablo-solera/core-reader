    },
    "./redis/lock": {
      "types": "./dist/redis/lock.d.ts",
      "import": "./dist/redis/lock.js"
    },
    "./jobs/state-store": {
      "types": "./dist/jobs/state-store.d.ts",
      "import": "./dist/jobs/state-store.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    },
