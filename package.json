{
  "name": "@pablosla/core-reader",
  "version": "0.3.1",
  "description": "Shared contract, ports and infrastructure adapters (Express, BullMQ, Redis, S3) for the manufacturer readers.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/pablo-solera/core-reader.git" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "overrides": {
    "@types/node": "24.19.1"
  },
  "exports": {
    "./contract/v1": {
      "types": "./dist/contract/v1.d.ts",
      "import": "./dist/contract/v1.js"
    },
    "./application/ports/*": {
      "types": "./dist/application/ports/*.d.ts",
      "import": "./dist/application/ports/*.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js"
    },
    "./contract/openapi": {
      "types": "./dist/contract/openapi.d.ts",
      "import": "./dist/contract/openapi.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./application/v1-handlers": {
      "types": "./dist/application/v1-handlers.d.ts",
      "import": "./dist/application/v1-handlers.js"
    },
    "./application/readiness": {
      "types": "./dist/application/readiness.d.ts",
      "import": "./dist/application/readiness.js"
    },
    "./interfaces/http/express/*": {
      "types": "./dist/interfaces/http/express/*.d.ts",
      "import": "./dist/interfaces/http/express/*.js"
    },
    "./infrastructure/redis/*": {
      "types": "./dist/infrastructure/redis/*.d.ts",
      "import": "./dist/infrastructure/redis/*.js"
    },
    "./infrastructure/s3/*": {
      "types": "./dist/infrastructure/s3/*.d.ts",
      "import": "./dist/infrastructure/s3/*.js"
    },
    "./infrastructure/bullmq/*": {
      "types": "./dist/infrastructure/bullmq/*.d.ts",
      "import": "./dist/infrastructure/bullmq/*.js"
    },
    "./testing/conformance": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
    },
    "./infrastructure/bullmq/adapter": {
      "types": "./dist/infrastructure/bullmq/bullmq-adapter.d.ts",
      "import": "./dist/infrastructure/bullmq/bullmq-adapter.js"
    }
  },
  "files": [
    "dist",
    "src",
    "contract/v1/openapi.yaml",
    "docs/contract-v1.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0"
  },
  "peerDependencies": {
    "bullmq": "^6.3.12",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "bullmq": "6.3.12",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
}