  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "express": "5.2.1",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
